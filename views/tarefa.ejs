<!DOCTYPE html>
<html lang="pt-br">
<%- include('./partials/head') %>

  <body>
    <header>
      <div class="logo-box">logo do kanban</div>
      <nav>
        <a href="../index.html">Kanban Board</a>
        <a href="../html/usuario.html">Novo Usuário</a>
        <a href="../html/tarefa.html">Nova Tarefa</a>
      </nav>
    </header>


    <main>
      <h2>Nova Tarefa</h2>
      <form onsubmit="createTask(); return false;">
        <div class="form-group">
          <label>Executante</label>
          <select id="input-executante" required></select>
        </div>
        <div class="form-group">
          <label>Título</label>
          <input type="text" id="input-titulo" placeholder="Título da tarefa" required>
        </div>
        <div class="form-group">
          <label>Descrição</label>
          <textarea id="input-desc" rows="4" placeholder="Descrição da tarefa"></textarea>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Criar</button>
          <a href="../index.html" class="btn btn-secondary">Cancelar</a>
        </div>
      </form>
    </main>

    <%- include('./partials/footer') %>


      <script src="../public/js/main.js"></script>

  </body>

</html>