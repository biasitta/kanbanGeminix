<!DOCTYPE html>
<html lang="pt-br">
<%- include('./partials/head') %>

    <body>
        <header>
            <div class="logo-box">logo do kanban</div>
            <nav>
                <a href="../index.html">Kanban Board</a>
                <a href="../html/usuario.html">Novo Usuário</a>
                <a href="../html/tarefa.html">Nova Tarefa</a>
            </nav>
        </header>


        <main>
            <h2>Novo Usuário</h2>
            <form onsubmit="createUser(); return false;">
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="new-user-email" placeholder="email@exemplo.com" required>
                </div>
                <div class="form-group">
                    <label>Nome</label>
                    <input type="text" id="new-user-name" placeholder="Nome do executante" required>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Cadastrar</button>
                    <a href="../index.html" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </main>

        <%- include('./partials/footer') %>

            <!-- javascript que roda no front-end da aplicação(pasta public) -->
            <script src="/js/main.js"></script>

    </body>

</html>